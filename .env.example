# ====================================================================
# ERROR 404 — ENVIRONMENT CONFIGURATION TEMPLATE
# AI-Driven Hyper-Local Early Warning System for Severe Weather Nowcasting
# ====================================================================

# Backend Server Configuration
PORT=5001
NODE_ENV=development
API_BASE_URL=http://localhost:5001

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/error404_weather?schema=public"

# Redis Cache & Real-Time Pub/Sub (Future Phase Integration)
REDIS_URL="redis://localhost:6379"

# Machine Learning Service (Python FastAPI)
ML_SERVICE_URL="http://localhost:8000"

# ====================================================================
# Weather Data Ingestion Pipeline (Phase 2)
# ====================================================================
# Primary provider default: "open-meteo" (No API key needed, open WMO-standard surface model)
# Supported options: "open-meteo" | "openweathermap" | "weatherapi"
WEATHER_PROVIDER="open-meteo"
WEATHER_API_KEY=""
WEATHER_API_BASE_URL=""
WEATHER_REQUEST_TIMEOUT_MS=8000
WEATHER_REFRESH_INTERVAL_SECONDS=300
WEATHER_STALE_THRESHOLD_SECONDS=2700
ADMIN_INGEST_SECRET="error404-dev-secret"

# External Weather Radar & GIS Feeds (Future Phases - Phase 4+)
MAP_API_KEY=""
IMD_RADAR_FEED_URL=""
ISRO_MOSDAC_FEED_URL=""

# Emergency Alert Broadcast & CAP v1.2 Gateway (Phase 5+)
NDMA_CAP_WEBHOOK_URL=""
ALERT_DISPATCH_SECRET=""
